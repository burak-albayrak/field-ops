{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Analytics": {
    "BaseUrl": "https://analytics.example.com/",
    "TimeoutSeconds": 5
  },
  "OutboxProcessing": {
    "Enabled": true,
    "PollIntervalSeconds": 2,
    "BatchSize": 5,
    "LeaseSeconds": 30,
    "BaseRetrySeconds": 5,
    "MaxRetrySeconds": 300
  },
  "AllowedHosts": "*"
}
